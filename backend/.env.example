DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/dely_db
# Orígenes del frontend habilitados por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
# Clave con la que se firman los tokens JWT. Generá una propia, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
# Horas de validez del token (opcional, 8 por defecto)
JWT_HORAS=8
